# Copy to .env for local development (never commit .env).
#
# Docker: run `docker compose up` — DB_* values below are overridden by
#         docker-compose.yml (DB_HOST=db). You only need a .env file present.
#
# Bare metal: set DB_HOST=localhost and your local MySQL credentials.

DB_HOST=localhost
DB_USER=kanjava
DB_PASS=kanjava
DB_NAME=kanjava
DB_CHARSET=utf8mb4
DB_COLLATE=
APP_ENV=development
