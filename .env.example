# Copy to .env for local development (never commit .env).

APP_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://kanjava:kanjava@localhost:5432/kanjava

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Storage: "local" for dev, "s3" for DigitalOcean Spaces / S3-compatible
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage

# S3-compatible (optional — only when STORAGE_DRIVER=s3)
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_REGION=nyc3
# S3_BUCKET=kanjava-music
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://kanjava-music.nyc3.cdn.digitaloceanspaces.com

# Producer agreement version accepted at upload
AGREEMENT_VERSION=v1
