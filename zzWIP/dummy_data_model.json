{
	"organization":{
		"name":"{% company %}",
		"address1":"{% integer 1000 9999 %} {% street %}",
		"address2":"{% city %}, {% state %} {% postal %}",
		"country":"{% country %}",
		"website":"{% url %}",
		"mission":"{% sentence %}",
		"description":"{% paragraph %}",
		"market share":"{% number 0 100 2 %}"
	},
	"staff":[
		"{% repeat 10 %}",
		{
			"hire date":"{% date 01/01/1970 01/01/2015 %}",
			"shift start time":"{% time 7:00AM 10:00AM %}",
			"ID card number":"{% uid %}",
			"employee ID":"{% index %}",
			"first name":"{% first_name %}",
			"last name":"{% last_name %}",
			"email":"{% email %}",
			"phone number":"{% phone %}",
			"part-time":"{% boolean %}",
			"department":["{% random %}","Facilities","Sales","IT"]
		}
	]
}