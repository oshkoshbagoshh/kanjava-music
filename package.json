{
  "name": "kanjava-music",
  "version": "0.1.0",
  "private": true,
  "description": "Royalty-free sample/MIDI marketplace for ghost producers",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/workers/waveform.worker.ts",
    "build": "tsc && npm run build:client",
    "build:client": "esbuild src/client/main.ts --bundle --outfile=public/js/app.js --format=esm --sourcemap",
    "start": "node dist/index.js",
    "start:worker": "node dist/workers/waveform.worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "book:scaffold": "node scripts/scaffold-book-chapters.mjs",
    "book:verify": "node scripts/verify-book-scaffold.mjs",
    "dev:web": "npm run dev -w @kanjava/web",
    "build:web": "npm run build -w @kanjava/web"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "postgres": "^3.4.5",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/helmet": "^4.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "vitest": "^3.2.6",
    "typescript": "^5.8.2"
  }
}